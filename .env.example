# Production domain, without a trailing slash. Required for canonical links and sitemap.
SITE_URL=https://contractormoneylab.website
# A real monitored operator email. Required before public launch.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional integrations remain disabled until privacy and consent are configured.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# This flag alone never permits ad requests; connect AdSlot consentGranted to a compliant CMP first.
NEXT_PUBLIC_ADS_ENABLED=false

